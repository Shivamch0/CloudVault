# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (support MONGO_URL or MONGODB_URI)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRY=7d

# AWS S3 Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-cloudvault-bucket-name
# Optional AWS credentials (if not using AWS CLI ~/.aws/credentials or IAM role)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Storage Policies
MAX_UPLOAD_SIZE_MB=10
USER_STORAGE_QUOTA_MB=500
PRESIGNED_URL_EXPIRY_SECONDS=300

